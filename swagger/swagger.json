        ],
        "summary": "Tra loi trong vong hoc",
        "operationId": "answerLearnRound",
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/decks/{deckId}/learn/session": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeckId"
        }
      ],
      "get": {
        "tags": [
          "Learn"
        ],
        "summary": "Lay phien hoc hien tai",
        "operationId": "getCurrentLearnSession",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      },
      "post": {
        "tags": [
          "Learn"
        ],
        "summary": "Bat dau phien hoc",
        "operationId": "startLearnSession",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "master",
                      "cram"
                    ]
                  },
                  "config": {
                    "type": "object",
                    "properties": {
                      "types": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "multiple_choice",
                            "true_false",
                            "written",
                            "flashcard"
                          ]
                        }
                      },
                      "answerSide": {
                        "type": "string",
                        "enum": [
                          "front",
                          "back"
                        ]
                      },
                      "writtenGradeMode": {
                        "type": "string",
                        "enum": [
                          "strict",
                          "moderate",
                          "loose"
                        ]
                      },
                      "retypeWrongAnswers": {
                        "type": "boolean",
                        "default": false
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/decks/{deckId}/learn/session/answer": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeckId"
        }
      ],
      "post": {
        "tags": [
          "Learn"
        ],
        "summary": "Tra loi trong phien hoc",
        "operationId": "answerLearnSession",
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/decks/{deckId}/learn/session/override": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeckId"
        }
      ],
      "post": {
        "tags": [
          "Learn"
        ],
        "summary": "Ghi de phien hoc hien tai",
        "operationId": "overrideLearnSession",
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/decks/{deckId}/learn/session/retype": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeckId"
        }
      ],
      "post": {
        "tags": [
          "Learn"
        ],
        "summary": "Go lai dap an dung sau khi tra loi sai",
        "operationId": "retypeLearnSessionAnswer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "flashcardId",
                  "typedAnswer"
                ],
                "properties": {
                  "flashcardId": {
                    "type": "string"
                  },
                  "typedAnswer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/decks/{deckId}/learn/session/reset": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeckId"
        }
      ],
      "post": {
        "tags": [
          "Learn"
        ],
        "summary": "Dat lai phien hoc",
        "operationId": "resetLearnSession",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "restart": {
                    "type": "boolean",
                    "default": false
                  },
                  "resetProgress": {
                    "type": "boolean",
                    "default": false,
                    "description": "Xoa CardProgress cua user trong deck; du lieu nay dung chung voi Study va Quiz."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "master",
                      "cram"
                    ]
                  },
                  "config": {
                    "type": "object"
                  }
                }
              }
            }
          }
