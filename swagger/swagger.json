  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "DeckId": {
        "name": "deckId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CardId": {
        "name": "cardId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "requestBodies": {
      "JsonBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            },
            "example": {}
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "StudyStreak": {
        "type": "object",
        "properties": {
          "currentDays": {
            "type": "integer",
            "minimum": 0,
            "example": 6
          },
          "longestDays": {
            "type": "integer",
            "minimum": 0,
            "example": 18
          },
          "lastStudyDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-07-29"
          },
          "timezone": {
            "type": "string",
            "enum": [
              "Asia/Ho_Chi_Minh"
            ]
          }
        },
        "required": [
          "currentDays",
          "longestDays",
          "lastStudyDate",
          "timezone"
        ]
      },
      "DashboardResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Lay tong quan hoc tap thanh cong."
          },
          "data": {
            "type": "object",
            "properties": {
              "stats": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "studyStreak": {
                "$ref": "#/components/schemas/StudyStreak"
              },
              "progressByStatus": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "recentDecks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "recentAttempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "stats",
              "studyStreak",
              "progressByStatus",
              "recentDecks",
              "recentAttempts"
            ]
          }
        },
        "required": [
          "statusCode",
          "message",
          "data"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": true
      }
    },
    "responses": {
      "Success": {
        "description": "Thanh cong",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "Created": {
        "description": "Tao moi thanh cong",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "BadRequest": {
